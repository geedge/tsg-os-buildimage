[global_tags]
   device_id = "${device_id}"
[agent]
   interval = "5s"
   round_interval = true
   metric_batch_size = 1000
   metric_buffer_limit = 10000
   collection_jitter = "0s"
   flush_interval = "1s"
   flush_jitter = "0s"
   precision = ""
   debug = false
   quiet = false
   logfile = ""
   hostname = ""
   omit_hostname = false

[[outputs.kafka]]
   sasl_username = "admin"
   sasl_password = "galaxy2019"
{% raw %}   brokers = [ "{{ olap.kafka_broker.address_list | join("\",\"") }}" ]
{% endraw %}
   topic = "TRAFFIC-METRICS"
   data_format = "json"
[[inputs.socket_listener]]
   service_address = "udp://:8100"
   data_format = "influx"