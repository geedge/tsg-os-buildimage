[Unit]
Description=Tsg os provision
Requires=network.target tsg-os-provision-convertor.service
After=network.target tsg-os-provision-convertor.service
Before=tfe-env.service mrenv.service certstore.service telegraf_statistic.service cert-redis.service

[Service]
ExecStart=/bin/sh -c "/opt/tsg/tsg-os-provision/provision.sh"
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
RequiredBy=tfe-env.service mrenv.service certstore.service telegraf_statistic.service cert-redis.service
