feature:
  enable_policy_local_cache: 1
  enable_stream_bypass_under_ddos: 0
  stream_bypass_trigger_cpu_usage: 85

firewall:
  enable: 1

proxy:
  enable: 1

connsketch:
  enable: 1

capturepacket:
  enable: 1
  
wannat:
  enable: 1
  natgw_address: "127.0.0.1"
  toroad_address: "127.0.0.1"
