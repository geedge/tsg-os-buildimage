    ip: "127.0.0.1"
    port_range: 7002
    port_num: 1
    db: 
      index_static: 0
      index_dynamic: 1

sentry_url: http://127.0.0.1:9000/api/2/minidump/?sentry_key=3203b43fd5384a7dbe6a48ecb1f3c595


data_center:
  name: City instance
  id: 1


OLAP:
  kafka_broker:
    address_list: ['1.1.1.1:9092','2.2.2.2:9092']
  hos_server:
    ip: "127.0.0.1"
    port: 9098

APP_SKETCH:
  broker:
    ip: "127.0.0.1"
    port: 1883

cache:
  hos:
    ip: "127.0.0.1"
    port: 9090


# NPB_device value in [inline_device, tera,direct]
NPB_device: inline_device

zone_group_list:
  - internal:
      vlan_id: 1301
      tracking_ip:
        ipv4: 127.0.0.1
        ipv6: '\:\:1'
    external:
      vlan_id: 1302
      tracking_ip:
        ipv4: 127.0.0.1
        ipv6: '\:\:1'
  - internal:
      vlan_id: 1201
      tracking_ip:
        ipv4: 127.0.0.1
        ipv6: '\:\:1'
    external:
      vlan_id: 1202
      tracking_ip:
        ipv4: 127.0.0.1
        ipv6: '\:\:1'

inline_device_settings:
  keepalive:
    ip: 127.0.0.1
    mask: 255.255.255.0

maat_redis_city_server:
  address: "10.4.62.253"
  port: 7002

feature:
  enable_policy_local_cache: 1