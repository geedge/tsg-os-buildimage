                    "format": [
                        "json"
                    ]
                }
            ]
        },
        {
            "switch": "on",
            "async": "off",
            "name": "STATISTICS-RULE-METRIC",
            "topic": "STATISTICS-RULE-METRIC",
            "client_id": "STATISTICS-RULE-METRIC",
            "mode": [
                {
                    "channel": "kafka",
                    "format": [
                        "json"
                    ]
                }
            ]
        },
        {
            "switch": "on",
            "async": "off",
            "name": "OBJECT-STATISTICS-METRIC",
            "topic": "OBJECT-STATISTICS-METRIC",
            "client_id": "OBJECT-STATISTICS-METRIC",
            "mode": [
                {
