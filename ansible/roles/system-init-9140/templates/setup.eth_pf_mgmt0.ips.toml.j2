#!/bin/bash

INF="$1"
STA="$2"

logger "$0 called for interface named $INF with $STA ..."

if [ "$INF" == "eth_pf_mgmt0" ]
then
  logger "$0: Interface $INF with $STA ,Set $INF ipaddr ..."
  output=$(ipmitool picmg addrinfo)
  echo $output
  substr=${output:22:1}
  echo $substr
  num=$((16#${substr}+16))
  ipaddr='10.254.'$num'.1'
  ifconfig eth_pf_mgmt0 $ipaddr netmask 255.255.0.0
fi