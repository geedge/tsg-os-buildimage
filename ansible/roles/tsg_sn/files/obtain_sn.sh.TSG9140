#!/bin/bash -x

output=`sshpass -p eb-20170122 ssh root@10.254.17.1 "ipmitool fru | awk 'NR==12'"`
if [  -z "$output" ];then
    echo "{\"sn\": \"unknown\"}" > /opt/tsg/etc/tsg_sn.json
    exit 0
fi
sn=`echo $output | awk '{print $4}'`
if [  -z "$sn" ];then
    echo "{\"sn\": \"unknown\"}" > /opt/tsg/etc/tsg_sn.json
    exit 0
fi
echo "{\"sn\": \"$sn\"}" > /opt/tsg/etc/tsg_sn.json
