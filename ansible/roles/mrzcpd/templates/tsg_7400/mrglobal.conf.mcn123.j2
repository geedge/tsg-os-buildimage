[device]
device={{ mrzcpd.mrglobal_conf_mcn123.device.nic_mirr }}
sz_tunnel=8192
sz_buffer=0

[device:{{ mrzcpd.mrglobal_conf_mcn123.device.nic_mirr }}]
jumbo_frame=1
max_rx_pkt_len=15360
clear_tx_flags=1
promisc=1

[service]
iocore={{ mrzcpd.mrglobal_conf_mcn123.service.iocore }}

[eal]
virtaddr=0x7d0000000000
loglevel=7

[keepalive]
check_spinlock=1

[pool]
create_mode=3
sz_direct_pktmbuf=4194304
sz_indirect_pktmbuf=8192
sz_cache=256
sz_data=4096
