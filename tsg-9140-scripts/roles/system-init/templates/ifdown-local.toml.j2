#!/bin/sh

IN="$1"
if [ "$1" == "enp1s0" ]
then
logger "$0: Interface $1 Down,Rmove $1 VF And Vlan ..."
echo 0 >/sys/class/net/enp1s0/device/sriov_numvfs
elif [ "$1" == "enp130s0" ]
then
logger "$0: Interface $1 Down,Rmove $1 VF And Vlan ..."
echo 0 > /sys/class/net/enp130s0/device/sriov_numvfs
elif [ "$1" == "enp131s0f0" ]
then
logger "$0: Interface $1 Down"
fi
exit 0